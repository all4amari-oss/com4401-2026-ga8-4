<mxfile host="app.diagrams.net"><diagram id="main" name="Main flowchart"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl1" value="Pennine Pizza Works: Main flowchart design" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="500" height="30" as="geometry"/></mxCell><mxCell id="t1" value="Main" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8DAF5;strokeColor=#7B5BA6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170.0" y="50" width="140" height="50" as="geometry"/></mxCell><mxCell id="n_t1" value="ABSTRACTION: Main sets up the data, then calls one subroutine for each stage of the order." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="50.0" width="340" height="50" as="geometry"/></mxCell><mxCell id="d_t1" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#666666;" edge="1" parent="1" source="t1" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1" value="Declare arrays:&lt;br&gt;String customerDetails[3], String sizeNames[3],&lt;br&gt;Real sizePrice[3], Real toppingPrice[5],&lt;br&gt;Integer chosenSize[6], Integer chosenToppings[6], Real totals[4]&lt;br&gt;Declare: Integer noOfPizzas, String delivery" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#9E9D24;" vertex="1" parent="1"><mxGeometry x="40.0" y="140" width="400" height="100" as="geometry"/></mxCell><mxCell id="e_p1" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="t1" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_p1" value="Setup data structures and variables. Main owns every array and passes them to the subroutines." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="155.0" width="340" height="70" as="geometry"/></mxCell><mxCell id="d_p1" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#666666;" edge="1" parent="1" source="p1" target="n_p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1" value="getCustomerDetails(customerDetails)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="40.0" y="280" width="400" height="50" as="geometry"/></mxCell><mxCell id="e_s1" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="p1" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_s1" value="ABSTRACTION: get customer details.&lt;br&gt;Fills customerDetails[0] = name, [1] = address, [2] = phone. Each is checked by checkBlank." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="280.0" width="340" height="50" as="geometry"/></mxCell><mxCell id="d_s1" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#666666;" edge="1" parent="1" source="s1" target="n_s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2" value="noOfPizzas = getPizzas()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#9E9D24;" vertex="1" parent="1"><mxGeometry x="40.0" y="370" width="400" height="50" as="geometry"/></mxCell><mxCell id="e_p2" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="s1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_p2" value="ABSTRACTION: get the number of pizzas.&lt;br&gt;Returns a whole number from 1 to 6." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="370.0" width="340" height="50" as="geometry"/></mxCell><mxCell id="d_p2" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#666666;" edge="1" parent="1" source="p2" target="n_p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2" value="choosePizzas(sizeNames, sizePrice, toppingPrice,&lt;br&gt;noOfPizzas, chosenSize, chosenToppings)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="40.0" y="460" width="400" height="60" as="geometry"/></mxCell><mxCell id="e_s2" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="p2" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_s2" value="ABSTRACTION: load the price lists, show the menu, choose size and toppings for each pizza.&lt;br&gt;Fills chosenSize[ ] and chosenToppings[ ]." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="460.0" width="340" height="60" as="geometry"/></mxCell><mxCell id="d_s2" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#666666;" edge="1" parent="1" source="s2" target="n_s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3" value="delivery = getDelivery()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#9E9D24;" vertex="1" parent="1"><mxGeometry x="40.0" y="560" width="400" height="50" as="geometry"/></mxCell><mxCell id="e_p3" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="s2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_p3" value="ABSTRACTION: delivery or collection.&lt;br&gt;Returns &quot;Y&quot; or &quot;N&quot;." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="560.0" width="340" height="50" as="geometry"/></mxCell><mxCell id="d_p3" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#666666;" edge="1" parent="1" source="p3" target="n_p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s3" value="calcTotals(sizePrice, toppingPrice, chosenSize,&lt;br&gt;chosenToppings, noOfPizzas, delivery, totals)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="40.0" y="650" width="400" height="60" as="geometry"/></mxCell><mxCell id="e_s3" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="p3" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_s3" value="ABSTRACTION: work out the totals.&lt;br&gt;Fills totals[0] subtotal, [1] 10% discount if over £20, [2] £2.50 delivery if wanted, [3] final total." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="650.0" width="340" height="60" as="geometry"/></mxCell><mxCell id="d_s3" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#666666;" edge="1" parent="1" source="s3" target="n_s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s4" value="displayBill(customerDetails, sizeNames, sizePrice, toppingPrice,&lt;br&gt;chosenSize, chosenToppings, noOfPizzas, totals)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="40.0" y="750" width="400" height="60" as="geometry"/></mxCell><mxCell id="e_s4" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_s4" value="ABSTRACTION: display the itemised bill.&lt;br&gt;Reads the arrays. All money to 2 decimal places." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="750.0" width="340" height="60" as="geometry"/></mxCell><mxCell id="d_s4" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#666666;" edge="1" parent="1" source="s4" target="n_s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t2" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8DAF5;strokeColor=#7B5BA6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170.0" y="850" width="140" height="50" as="geometry"/></mxCell><mxCell id="e_t2" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="s4" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="struct" name="Structure chart"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl2" value="Pennine Pizza Works: structure chart (which subroutine calls which)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="700" height="30" as="geometry"/></mxCell><mxCell id="m" value="Main" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8DAF5;strokeColor=#7B5BA6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="50" width="140" height="50" as="geometry"/></mxCell><mxCell id="gcd" value="getCustomerDetails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="150" height="50" as="geometry"/></mxCell><mxCell id="emgcd" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m" target="gcd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gp" value="getPizzas&lt;br&gt;returns Integer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="190" y="170" width="150" height="50" as="geometry"/></mxCell><mxCell id="emgp" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m" target="gp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cp" value="choosePizzas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="360" y="170" width="150" height="50" as="geometry"/></mxCell><mxCell id="emcp" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m" target="cp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gd" value="getDelivery&lt;br&gt;returns String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="530" y="170" width="150" height="50" as="geometry"/></mxCell><mxCell id="emgd" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m" target="gd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ct" value="calcTotals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="150" height="50" as="geometry"/></mxCell><mxCell id="emct" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m" target="ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="db" value="displayBill" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="870" y="170" width="150" height="50" as="geometry"/></mxCell><mxCell id="emdb" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cb" value="checkBlank&lt;br&gt;returns String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="150" height="50" as="geometry"/></mxCell><mxCell id="ecb" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="gcd" target="cb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pm" value="populateMenu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="200" y="290" width="140" height="50" as="geometry"/></mxCell><mxCell id="ecppm" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="cp" target="pm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dm" value="displayMenu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="360" y="290" width="140" height="50" as="geometry"/></mxCell><mxCell id="ecpdm" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="cp" target="dm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ms" value="makeSizeChoice" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="140" height="50" as="geometry"/></mxCell><mxCell id="ecpms" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="cp" target="ms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gt" value="getToppings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="140" height="50" as="geometry"/></mxCell><mxCell id="ecpgt" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="cp" target="gt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="key" value="Read top to bottom: each box calls the boxes joined underneath it. choosePizzas repeats displayMenu, makeSizeChoice and getToppings once for each pizza (1 to 6)." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="1000" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
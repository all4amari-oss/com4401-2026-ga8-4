<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Sorenas Flowchart"/>
        <attribute name="authors" value="soren"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-09 04:44:08 AM"/>
        <attribute name="created" value="c29yZW47SkFSVklTOzIwMjYtMTAtMDk7MDM6Mjk6NDQgQU07MjI4NQ=="/>
        <attribute name="edited" value="c29yZW47SkFSVklTOzIwMjYtMTAtMDk7MDQ6NDQ6MDggQU07MTsyMzkx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="customerDetails" type="String" array="True" size="3"/>
            <declare name="sizeNames" type="String" array="True" size="3"/>
            <declare name="sizePrice" type="Real" array="True" size="3"/>
            <declare name="toppingPrice" type="Real" array="True" size="5"/>
            <declare name="chosenSize" type="Integer" array="True" size="6"/>
            <declare name="chosenToppings" type="Integer" array="True" size="6"/>
            <declare name="totals" type="Real" array="True" size="4"/>
            <declare name="noOfPizzas" type="Integer" array="False" size=""/>
            <declare name="delivery" type="String" array="False" size=""/>
            <call expression="getCustomerDetails(customerDetails)"/>
            <assign variable="noOfPizzas" expression="getPizzas()"/>
            <call expression="choosePizzas"/>
            <assign variable="delivery" expression="getDelivery()"/>
            <call expression="calcTotals(sizePrice, toppingPrice, chosenSize, chosenToppings, noOfPizzas, delivery, totals)"/>
            <call expression="displayBill(customerDetails, sizeNames, sizePrice, toppingPrice, chosenSize, chosenToppings, noOfPizzas, totals)"/>
        </body>
    </function>
    <function name="calcTotals" type="None" variable="">
        <parameters/>
        <body/>
    </function>
    <function name="checkBank" type="Boolean" variable="isValid">
        <parameters>
            <parameter name="paymentInfo" type="String" array="False"/>
        </parameters>
        <body>
            <declare name="isValid" type="Boolean" array="False" size=""/>
            <assign variable="isValid" expression="Len(paymentInfo) &gt; 0"/>
        </body>
    </function>
    <function name="choosePizzas" type="None" variable="">
        <parameters>
            <parameter name="sizeNames" type="String" array="True"/>
            <parameter name="sizePrice" type="Real" array="True"/>
            <parameter name="toppingPrice" type="Real" array="True"/>
            <parameter name="no0fPizzas" type="Integer" array="False"/>
            <parameter name="chosenSize" type="Integer" array="True"/>
            <parameter name="chosenToppings" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="i" expression="0"/>
            <while expression="i &lt; noOfPizzas">
                <output expression="&quot;Choose pizza size: 1=Small, 2=Medium, 3=Large&quot;" newline="True"/>
                <input variable="chosenSize[i]"/>
                <while expression=""/>
            </while>
        </body>
    </function>
    <function name="customerDetails" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Enter customer name:&quot;" newline="True"/>
            <input variable="customerDetails[0]"/>
            <output expression="&quot;Enter customer address:&quot;" newline="True"/>
            <input variable="customerDetails[1]"/>
            <output expression="&quot;Enter payment details:&quot;" newline="True"/>
            <input variable="customerDetails[2]"/>
            <if expression="checkBank(customerDetails[2])">
                <then>
                    <output expression="&quot;Payment details entered&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Payment details missing&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="displayBill" type="None" variable="">
        <parameters/>
        <body/>
    </function>
    <function name="getDelivery" type="String" variable="">
        <parameters/>
        <body/>
    </function>
    <function name="getPizzas" type="Integer" variable="">
        <parameters/>
        <body>
            <output expression="&quot;How many pizzas? (1-6)&quot;" newline="True"/>
            <input variable="pizzaCount"/>
            <while expression="pizzaCount &lt; 1 or pizzaCount &gt; 6"/>
            <input variable="pizzaCount"/>
            <output expression="&quot;Invalid number. Enter 1 to 6:&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
